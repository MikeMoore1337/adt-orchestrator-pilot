+
+#[test]
+fn writable_git_ref_file_does_not_get_directory_metadata_children() {
+    let temp_dir = TempDir::new().expect("temp dir");
+    let worktree = temp_dir.path().join("worktree");
+    let git_dir = worktree.join(".git");
+    let writable_dir = worktree.join("editable");
+    std::fs::create_dir_all(&git_dir).expect("create git metadata dir");
+    std::fs::create_dir_all(&writable_dir).expect("create editable dir");
+    let branch_ref = git_dir.join("HEAD");
+    std::fs::write(&branch_ref, "deadbeef\n").expect("create regular Git ref file");
+
+    let policy = FileSystemSandboxPolicy::restricted(vec![
+        FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(&worktree)
+                .expect("absolute worktree")
+                .into(),
+            FileSystemAccessMode::Read,
+        ),
+        FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(&branch_ref)
+                .expect("absolute Git ref")
+                .into(),
+            FileSystemAccessMode::Write,
+        ),
+        FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(&writable_dir)
+                .expect("absolute editable directory")
+                .into(),
+            FileSystemAccessMode::Write,
+        ),
+    ]);
+
+    let args = create_filesystem_args(
+        &policy,
+        &worktree,
+        BwrapOptions::default(),
+    )
+    .expect("exact-file permission must construct bubblewrap arguments")
+    .args;
+    let branch_ref = path_to_string(&branch_ref);
+
+    assert!(
+        args.windows(3)
+            .any(|args| args == ["--bind", branch_ref.as_str(), branch_ref.as_str()]),
+        "regular file must still be bound writable: {args:?}"
+    );
+    for name in [".git", ".aws", ".agents", ".codex"] {
+        let synthetic_child = format!("{branch_ref}/{name}");
+        assert!(
+            !args.iter().any(|arg| arg == &synthetic_child),
+            "regular file cannot have metadata descendants: {synthetic_child}"
+        );
+    }
+    // The fix must NOT remove metadata protections on actual directory roots.
+    assert_empty_directory_mounted_read_only(&args, &writable_dir.join(".git"));
+    assert_empty_directory_mounted_read_only(&args, &writable_dir.join(".aws"));
+}
 
