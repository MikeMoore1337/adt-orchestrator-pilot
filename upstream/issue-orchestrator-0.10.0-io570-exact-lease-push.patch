+def io570_exact_lease_push_args(
+    run_git: GitCommand,
+    worktree: Path,
+    remote: str,
+    branch: str,
+    *,
+    set_upstream: bool = True,
+    dry_run: bool = False,
+    env: dict[str, str] | None = None,
+) -> list[str]:
+    """Pilot-only exact-lease push, not based on remote-tracking refs.
+
+    The restricted fetch refspec may track only main. Fetching a branch
+    by name populates FETCH_HEAD, but does not necessarily track it.
+    Verify remote tip, fetch it, require fast-forward ancestry, and
+    use an explicit SHA lease to reject concurrent remote changes.
+    """
+    if os.environ.get("ISSUE_ORCHESTRATOR_IO570_EXACT_LEASE_PUSH") != "1":
+        raise ValueError("exact-lease pilot opt-in is not enabled")
+    if remote != "origin" or not re.fullmatch(r"(?:20|21)-[a-z0-9][a-z0-9-]*/agent", branch):
+        raise ValueError("exact-lease pilot allows only scoped #20/#21 agent branches on origin")
+    target_ref = f"refs/heads/{branch}"
+
+    def read(*argv: str):
+        return run_git(worktree, list(argv), check=False, timeout_s=60, env=env)
+
+    symbolic = read("symbolic-ref", "--quiet", "--short", "HEAD")
+    if symbolic.returncode != 0 or symbolic.stdout.strip() != branch:
+        raise ValueError("push worktree is no longer on the expected agent branch")
+    head = read("rev-parse", "--verify", "HEAD")
+    local_sha = head.stdout.strip()
+    if head.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", local_sha):
+        raise ValueError("local HEAD identity cannot be verified")
+
+    listing = read("ls-remote", "--heads", remote, target_ref)
+    if listing.returncode != 0:
+        raise ValueError("cannot observe exact remote agent branch")
+    rows = [line.split("\t") for line in listing.stdout.splitlines() if line]
+    if len(rows) > 1 or any(len(row) != 2 or row[1] != target_ref or not re.fullmatch(r"[0-9a-f]{40}", row[0]) for row in rows):
+        raise ValueError("unexpected remote ref identity; refusing ambiguous lease")
+
+    expected = rows[0][0] if rows else ""
+    if expected:
+        fetched = read("fetch", "--no-tags", remote, target_ref)
+        if fetched.returncode != 0:
+            raise ValueError("cannot fetch exact remote branch for ancestry verification")
+        fetched_head = read("rev-parse", "--verify", "FETCH_HEAD")
+        if fetched_head.returncode != 0 or fetched_head.stdout.strip() != expected:
+            raise ValueError("remote branch changed during lease preparation")
+        ancestor = read("merge-base", "--is-ancestor", expected, local_sha)
+        if ancestor.returncode != 0:
+            raise ValueError("remote branch does not belong to local HEAD history")
+
+    args = ["push", f"--force-with-lease={target_ref}:{expected}"]
+    if dry_run:
+        args.append("--dry-run")
+    if set_upstream:
+        args.append("-u")
+    args.extend([remote, f"HEAD:{target_ref}"])
+    return args
+
