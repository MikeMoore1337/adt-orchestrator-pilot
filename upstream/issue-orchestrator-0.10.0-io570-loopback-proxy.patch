+def _io570_loopback_proxy(scope: SandboxScope) -> bool:
+    """Opt in only for the owner's disposable synthetic #570 worktrees.
+
+    This is not a generic port-restricted network capability: the Codex
+    managed proxy matches the host, not the callback server's exact port.
+    """
+    if os.environ.get("ISSUE_ORCHESTRATOR_IO570_LOOPBACK_PROXY") != "1":
+        return False
+    root = (Path.home() / "projects/adt-orchestrator-pilot-worktrees").resolve()
+    worktree = scope.working_directory.resolve()
+    if (
+        scope.egress != "model-only"
+        or worktree == root
+        or not worktree.is_relative_to(root)
+    ):
+        raise SandboxUnsupportedError(
+            "IO570 loopback proxy is restricted to the isolated pilot worktrees"
+        )
+    return True
+
+
